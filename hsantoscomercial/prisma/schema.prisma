// Prisma schema — HSantos Comercial
// SaaS de controle de gastos pessoais + CRM via WhatsApp Business

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenant: cada usuário é um inquilino isolado com seus próprios dados.
// ---------------------------------------------------------------------------
model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  // Número do WhatsApp do próprio usuário (formato E.164 sem "+"), usado para
  // associar mensagens recebidas ao tenant correto.
  whatsappNumber String?  @unique
  currency       String   @default("AOA")
  language       String   @default("pt")
  monthlyBudget  Decimal? @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  categories         Category[]
  transactions       Transaction[]
  contacts           Contact[]
  interactions       Interaction[]
  conversationStates ConversationState[]
  messages           WhatsappMessage[]
}

enum TransactionType {
  EXPENSE
  INCOME
}

enum Source {
  WHATSAPP
  WEB
}

model Category {
  id     String          @id @default(cuid())
  userId String
  name   String
  type   TransactionType @default(EXPENSE)
  emoji  String          @default("💸")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name, type])
  @@index([userId])
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  type        TransactionType @default(EXPENSE)
  amount      Decimal         @db.Decimal(12, 2)
  description String?
  categoryId  String?
  source      Source          @default(WHATSAPP)
  occurredAt  DateTime        @default(now())
  createdAt   DateTime        @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([categoryId])
}

// ---------------------------------------------------------------------------
// CRM
// ---------------------------------------------------------------------------
enum Stage {
  LEAD
  PROSPECT
  NEGOTIATION
  CUSTOMER
  LOST
}

model Contact {
  id        String   @id @default(cuid())
  userId    String
  name      String
  phone     String?
  email     String?
  company   String?
  stage     Stage    @default(LEAD)
  value     Decimal? @db.Decimal(12, 2)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  interactions Interaction[]

  @@index([userId, stage])
}

enum InteractionType {
  NOTE
  CALL
  MESSAGE
  MEETING
  TASK
}

model Interaction {
  id        String          @id @default(cuid())
  userId    String
  contactId String
  type      InteractionType @default(NOTE)
  content   String
  dueAt     DateTime?
  done      Boolean         @default(false)
  createdAt DateTime        @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([userId, dueAt])
  @@index([contactId])
}

// ---------------------------------------------------------------------------
// WhatsApp: estado de conversa (fluxos multi-etapa) e log de mensagens.
// ---------------------------------------------------------------------------
model ConversationState {
  id           String   @id @default(cuid())
  userId       String
  whatsappFrom String   @unique
  state        Json     @default("{}")
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Direction {
  IN
  OUT
}

model WhatsappMessage {
  id          String    @id @default(cuid())
  userId      String?
  direction   Direction
  waMessageId String?
  from        String
  to          String
  body        String?
  payload     Json?
  createdAt   DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}
